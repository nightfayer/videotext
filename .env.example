# Токен вашего бота от @BotFather в Telegram
BOT_TOKEN=123456789:AA...Ваш_Токен_От_BotFather

# API ID и API HASH от https://my.telegram.org (нужны для загрузки файлов > 20 МБ до 2 ГБ)
API_ID=12345678
API_HASH=abcdef0123456789abcdef0123456789

# Модель Whisper: tiny, base, small, medium, large-v3, turbo
WHISPER_MODEL=small

# Устройство: cuda (для видеокарты NVIDIA) или cpu
DEVICE=cuda

# Тип вычислений: float16 (для GPU) или int8 (для CPU)
COMPUTE_TYPE=float16

# Язык распознавания (оставьте пустым для автоопределения или укажите 'ru', 'en')
WHISPER_LANGUAGE=ru

# Параметр поиска гипотез: 1 = Greedy Search (в 3 раза быстрее), 2 = баланс, 5 = максимум
BEAM_SIZE=1

# Максимальное количество параллельных задач распознавания
MAX_CONCURRENT_TASKS=1

# Белый список ID пользователей через запятую (оставьте пустым для общего доступа)
ALLOWED_USERS=

# NVIDIA NIM AI Model (Умные AI-функции: Саммари, Главные тезисы, Готовый пост, Хэштеги)
NVIDIA_API_KEY=
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
